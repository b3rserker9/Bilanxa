# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Share useful VS Code configuration, exclude personal workspace files.
/.vscode/*
!/.vscode/launch.json
!/.vscode/tasks.json
!/.vscode/settings.json
!/.vscode/extensions.json
*.code-workspace

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
# Covers both Flutter output and nested Android/Gradle build directories.
**/build/
/coverage/
**/.gradle/
**/.kotlin/
**/.cxx/
**/.externalNativeBuild/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/
# Firebase configurations are generated locally by FlutterFire.
/lib/firebase_options.dart
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist
**/service-account*.json
**/*service_account*.json
**/*firebase-adminsdk*.json
*.jks
*.keystore
*.p12
*.pfx
*.pem
android/key.properties

# Keep the checked-in demo/production templates; other config JSON is local.
/config/*.json
!/config/local.json
!/config/production.json

# Environment files and local Firebase tooling output.
.env
.env.*
!.env.example
!.env.sample
.firebase/
firebase-debug.*
